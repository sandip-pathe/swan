# Firebase Console > Project settings > Your apps > Web app configuration.
# These browser values are public Firebase client configuration, not Admin credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public origin of the SWAN API. Use localhost for a local API or the hosted HTTPS
# origin when testing this frontend against Oracle. The API must allow this web origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Fixed shared Firebase login email; never put the six-digit password here.
NEXT_PUBLIC_BOT_LOGIN_EMAIL=jit4xxxx@gmail.com
