# Actual local credentials are generated by scripts/database.ps1 into ignored .env.
DATABASE_URL=postgresql+psycopg://swan:CHANGE_ME@127.0.0.1:54329/swan_trade

# Server-only Angel One configuration. Set real values locally; never in NEXT_PUBLIC_ variables.
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_LOCAL_IP=
ANGELONE_PUBLIC_IP=
ANGELONE_MAC_ADDRESS=
# Server-only Tradetron developer credential. Do not expose in frontend variables.
TRADETRON_API_KEY=
# Actual index references from Angel One, not guessed tokens.
ANGELONE_NIFTY_INDEX_TOKEN=
ANGELONE_SENSEX_INDEX_TOKEN=
# Server-only API key. Non-secret config/agents.json overrides the model and limits
# below when present; absent/empty model or zero budget disables agent requests.
OPENAI_API_KEY=
# Server-only NewsData.io credential. Select newsdata_free in news-sources.json.
# Free-tier headlines are delayed by 12 hours; never treated as live news.
NEWS_API_KEY=
OPENAI_MODEL=
SWAN_AI_DAILY_TOKEN_BUDGET=0
SWAN_AI_MAX_OUTPUT_TOKENS=2000
SWAN_AI_TIMEOUT_SECONDS=25

# Backend Firebase token verification: public project identity, no Admin key needed.
# Use the same projectId as the browser web app configuration.
FIREBASE_PROJECT_ID=
# First verified local user enrolls as the sole owner; disabled by default for hosting.
SWAN_LOCAL_OWNER_BOOTSTRAP=false
# Optional compatibility mapping for already-existing paper accounts; not needed for local enrollment.
SWAN_ACCOUNT_BINDINGS={}
SWAN_WEB_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
