# Copy to runtime.env on the VM; chmod 600. No secret belongs in a source bundle.
FIREBASE_PROJECT_ID=REPLACE
SWAN_ACCOUNT_BINDINGS={"FIREBASE_USER_UID":"EXISTING_PAPER_ACCOUNT_UUID"}
SWAN_WEB_ORIGINS=["https://YOUR_PROJECT.vercel.app"]
ANGELONE_API_KEY=REPLACE
ANGELONE_CLIENT_CODE=REPLACE
ANGELONE_LOCAL_IP=REPLACE_WITH_VM_PRIVATE_IPV4
ANGELONE_PUBLIC_IP=REPLACE_WITH_VM_PUBLIC_IPV4
ANGELONE_MAC_ADDRESS=REPLACE_WITH_VM_MAC
ANGELONE_NIFTY_INDEX_TOKEN=REPLACE
ANGELONE_SENSEX_INDEX_TOKEN=REPLACE
OPENAI_API_KEY=REPLACE
NEWS_API_KEY=REPLACE
# config/agents.json controls model, token allowance and request timeout.
