# Reuse the installed, locked Python environment on the existing Oracle host.
# For a new host, build hosting/oracle/Dockerfile as swan-backend:local first.
FROM swan-backend:local
USER root
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --python /usr/local/bin/python
RUN mkdir -p /app/bot-data && chown 10001:10001 /app/bot-data
COPY --chown=10001:10001 services/bot /app/services/bot
COPY --chown=10001:10001 services/market/index_history.py services/market/stream.py services/market/catalog.py /app/services/market/
USER 10001:10001
CMD ["python", "-m", "uvicorn", "services.bot.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
