{
  "$defs": {
    "CostModel": {
      "additionalProperties": false,
      "properties": {
        "flat_per_fill": {
          "title": "Flat Per Fill",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "slippage_bps": {
          "title": "Slippage Bps",
          "type": "string"
        },
        "turnover_rate": {
          "title": "Turnover Rate",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "label",
        "flat_per_fill",
        "turnover_rate",
        "slippage_bps"
      ],
      "title": "CostModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capital": {
      "default": "100000",
      "title": "Capital",
      "type": "string"
    },
    "costs": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entry_cutoff_minutes": {
      "default": 20,
      "exclusiveMinimum": 0,
      "title": "Entry Cutoff Minutes",
      "type": "integer"
    },
    "flatten_minutes": {
      "default": 10,
      "exclusiveMinimum": 0,
      "title": "Flatten Minutes",
      "type": "integer"
    },
    "max_daily_loss_pct": {
      "default": "0.02",
      "title": "Max Daily Loss Pct",
      "type": "string"
    },
    "max_fill_quantity": {
      "exclusiveMinimum": 0,
      "title": "Max Fill Quantity",
      "type": "integer"
    },
    "max_holding_seconds": {
      "default": 300,
      "exclusiveMinimum": 0,
      "title": "Max Holding Seconds",
      "type": "integer"
    },
    "max_positions": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Max Positions",
      "type": "integer"
    },
    "max_spread_bps": {
      "title": "Max Spread Bps",
      "type": "string"
    },
    "max_trade_risk_pct": {
      "default": "0.005",
      "title": "Max Trade Risk Pct",
      "type": "string"
    },
    "min_oi": {
      "minimum": 0,
      "title": "Min Oi",
      "type": "integer"
    },
    "min_volume": {
      "minimum": 0,
      "title": "Min Volume",
      "type": "integer"
    },
    "quote_max_age_seconds": {
      "default": 2,
      "maximum": 10,
      "minimum": 1,
      "title": "Quote Max Age Seconds",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "max_spread_bps",
    "min_volume",
    "min_oi",
    "max_fill_quantity"
  ],
  "title": "RiskConfig",
  "type": "object"
}
