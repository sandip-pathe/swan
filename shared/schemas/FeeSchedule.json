      "title": "Notes",
      "type": "string"
    },
    "product": {
      "const": "LONG_OPTION_INTRADAY",
      "default": "LONG_OPTION_INTRADAY",
      "title": "Product",
      "type": "string"
    },
    "reviewed": {
      "default": false,
      "title": "Reviewed",
      "type": "boolean"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/FeeRule"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
