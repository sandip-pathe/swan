          "type": "string"
        },
        "finding": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "enum": [
