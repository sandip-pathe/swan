            "account_verified",
            "unverified"
          ],
          "title": "Status",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "checked_at",
        "finding",
        "status"
      ],
      "title": "SourceEvidence",
      "type": "object"
    }
