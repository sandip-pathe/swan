            "enum": [
              "BROKERAGE",
              "EXCHANGE",
              "STT",
              "SEBI",
              "STAMP",
              "GST",
              "IPFT",
              "CLEARING",
              "OTHER"
            ],
            "type": "string"
          },
          "title": "Charge Basis",
          "type": "array"
        },
        "code": {
          "enum": [
            "BROKERAGE",
            "EXCHANGE",
            "STT",
            "SEBI",
            "STAMP",
            "GST",
            "IPFT",
            "CLEARING",
            "OTHER"
          ],
          "title": "Code",
          "type": "string"
        },
        "rate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate"
        },
